---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" noindex>
  <div class="wrap">
    <header class="page-head" style="border:0">
      <span class="eyebrow">404</span>
      <h1>Page not found</h1>
      <p>The page you are looking for does not exist or has moved. Try the <a href="/">home page</a> or the <a href="/publications/">publications</a>.</p>
    </header>
  </div>
</BaseLayout>
