---
import profile from '../data/profile.yaml';
const icons: Record<string, string> = {
  email: '<path d="M3 5h18v14H3z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m3 6 9 7 9-7" fill="none" stroke="currentColor" stroke-width="1.8"/>',
  linkedin: '<path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>',
  scholar: '<path fill="currentColor" d="M5.24 13.77 0 9.5 12 0l12 9.5-5.24 4.27A7.5 7.5 0 0 0 12 9.5a7.5 7.5 0 0 0-6.76 4.27zM12 24a7 7 0 1 0 0-14 7 7 0 0 0 0 14z"/>',
  orcid: '<path fill="currentColor" d="M12 0a12 12 0 1 0 0 24 12 12 0 0 0 0-24zM7.37 4.38a.97.97 0 1 1 0 1.94.97.97 0 0 1 0-1.94zm-.72 3.04h1.44v10.07H6.65V7.42zm3.56 0h3.9c3.7 0 5.34 2.65 5.34 5.04 0 2.6-2.03 5.03-5.32 5.03h-3.92V7.42zm1.44 1.3v7.47h2.29c3.27 0 4.02-2.48 4.02-3.73 0-2.04-1.3-3.74-4.1-3.74h-2.21z"/>',
};
const items = [
  { key: 'email', label: 'Email', href: `mailto:${profile.email}` },
  { key: 'scholar', label: 'Google Scholar', href: profile.links.scholar },
  { key: 'orcid', label: 'ORCID', href: profile.links.orcid },
  { key: 'linkedin', label: 'LinkedIn', href: profile.links.linkedin },
].filter((i) => i.href);
---
<ul class="profile-links">
  {items.map((i) => (
    <li>
      <a href={i.href} target={i.key === 'email' ? undefined : '_blank'} rel={i.key === 'email' ? undefined : 'me noopener'}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[i.key]} />{i.label}
      </a>
    </li>
  ))}
  {profile.cv && <li><a href={profile.cv}>CV (PDF)</a></li>}
</ul>
